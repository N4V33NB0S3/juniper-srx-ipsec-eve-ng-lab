## SRX-1 / LAN-A baseline. Replace all <...> values; never commit a real PSK.
## Assumes ge-0/0/0 is WAN/untrust and ge-0/0/1 is LAN/trust.
set system host-name SRX-1
set interfaces ge-0/0/0 unit 0 family inet address <SRX1_WAN_IP>/<WAN_PREFIX>
set interfaces ge-0/0/1 unit 0 family inet address 192.168.10.1/24
set interfaces st0 unit 0 family inet
set security zones security-zone trust interfaces ge-0/0/1.0 host-inbound-traffic system-services ping
set security zones security-zone trust interfaces ge-0/0/1.0 host-inbound-traffic system-services ssh
set security zones security-zone untrust interfaces ge-0/0/0.0 host-inbound-traffic system-services ike
set security zones security-zone untrust interfaces ge-0/0/0.0 host-inbound-traffic system-services ping
set security zones security-zone untrust interfaces st0.0
set security zones security-zone trust address-book address LAN-A 192.168.10.0/24
set security zones security-zone untrust address-book address LAN-B 192.168.20.0/24
set routing-options static route <SRX2_WAN_IP>/32 next-hop <SRX1_WAN_NEXT_HOP>
set routing-options static route 192.168.20.0/24 next-hop st0.0
set security ike proposal IKEV2-PROP authentication-method pre-shared-keys
set security ike proposal IKEV2-PROP authentication-algorithm sha-256
set security ike proposal IKEV2-PROP encryption-algorithm aes-256-cbc
set security ike proposal IKEV2-PROP dh-group group14
set security ike proposal IKEV2-PROP lifetime-seconds 28800
set security ike policy IKEV2-POL mode main
set security ike policy IKEV2-POL proposals IKEV2-PROP
set security ike policy IKEV2-POL pre-shared-key ascii-text "<REPLACE_WITH_STRONG_PSK>"
set security ike gateway SRX-2-GW ike-policy IKEV2-POL
set security ike gateway SRX-2-GW address <SRX2_WAN_IP>
set security ike gateway SRX-2-GW external-interface ge-0/0/0.0
set security ike gateway SRX-2-GW version v2-only
set security ipsec proposal ESP-AES256-SHA256 protocol esp
set security ipsec proposal ESP-AES256-SHA256 authentication-algorithm hmac-sha-256-128
set security ipsec proposal ESP-AES256-SHA256 encryption-algorithm aes-256-cbc
set security ipsec proposal ESP-AES256-SHA256 lifetime-seconds 3600
set security ipsec policy IPSEC-POL proposals ESP-AES256-SHA256
set security ipsec vpn SRX-2-VPN bind-interface st0.0
set security ipsec vpn SRX-2-VPN ike gateway SRX-2-GW
set security ipsec vpn SRX-2-VPN ike ipsec-policy IPSEC-POL
set security ipsec vpn SRX-2-VPN establish-tunnels immediately
## Specific permit policies must stay above default-deny.
set security policies from-zone trust to-zone untrust policy LAN-A-TO-LAN-B match source-address LAN-A
set security policies from-zone trust to-zone untrust policy LAN-A-TO-LAN-B match destination-address LAN-B
set security policies from-zone trust to-zone untrust policy LAN-A-TO-LAN-B match application any
set security policies from-zone trust to-zone untrust policy LAN-A-TO-LAN-B then permit
set security policies from-zone trust to-zone untrust policy default-deny match source-address any
set security policies from-zone trust to-zone untrust policy default-deny match destination-address any
set security policies from-zone trust to-zone untrust policy default-deny match application any
set security policies from-zone trust to-zone untrust policy default-deny then deny
set security policies from-zone untrust to-zone trust policy LAN-B-TO-LAN-A match source-address LAN-B
set security policies from-zone untrust to-zone trust policy LAN-B-TO-LAN-A match destination-address LAN-A
set security policies from-zone untrust to-zone trust policy LAN-B-TO-LAN-A match application any
set security policies from-zone untrust to-zone trust policy LAN-B-TO-LAN-A then permit
set security policies from-zone untrust to-zone trust policy default-deny match source-address any
set security policies from-zone untrust to-zone trust policy default-deny match destination-address any
set security policies from-zone untrust to-zone trust policy default-deny match application any
set security policies from-zone untrust to-zone trust policy default-deny then deny
